        "delimiterEncoding": "text"
      },
      {
        "label": "Volume up",
        "payload": "00AUU",
        "encoding": "ascii",
        "delimiter": "cr",
        "delimiterCustom": "",
        "delimiterEncoding": "text"
      },
      {
        "label": "Volume down",
